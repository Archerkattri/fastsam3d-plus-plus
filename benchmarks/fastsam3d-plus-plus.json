{
  "schema_version": 1,
  "name": "fastsam3d-plus-plus-slat-ab",
  "entrypoint": "ab_accel_bench.py",
  "purpose": "GPU A/B comparison of the SLaT forecast basis and Adaptive-CFG.",
  "gpu_required": true,
  "install": [
    "pip install -r requirements.txt",
    "pip install 'hicache-pp>=1.2.1'"
  ],
  "inputs": {
    "image_dirs": "notebook/images/*/",
    "required_files": ["image.png", "<mask-index>.png"],
    "model_tag": "hf"
  },
  "configs": [
    {"basis": "taylor", "adaptive_cfg": false},
    {"basis": "hermite", "adaptive_cfg": false},
    {"basis": "taylor", "adaptive_cfg": true},
    {"basis": "hermite", "adaptive_cfg": true}
  ],
  "metrics": {
    "module": "metrics.py",
    "environment_variable": "FASTSAM3D_METRICS_PATH",
    "required_function": "chamfer_and_f1"
  },
  "command": "python ab_accel_bench.py --tag hf --mask-index 14 --gpu 0",
  "outputs": ["ab_accel_out/cells.json", "ab_accel_out/summary.json"],
  "scope": {
    "slat_basis": true,
    "ss_native_taylorseer_or_carving": "unchanged",
    "model_benchmark_included": false
  }
}
